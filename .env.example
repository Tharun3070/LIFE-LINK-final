# LifeLink Platform Environment Configuration

APP_ENV=development
DEBUG=True
HOST=0.0.0.0
PORT=8000

# Security & JWT
JWT_SECRET_KEY=change_this_secret_in_production_lifelink_jwt_key
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=120
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# Database Connection (SQLite in development, PostgreSQL in production)
# SQLite Development default:
DATABASE_URL=sqlite:///./lifelink.db
# PostgreSQL Production Example:
# DATABASE_URL=postgresql+psycopg://postgres:your_secure_password@localhost:5432/lifelink

# Database Pool Settings (PostgreSQL)
DB_POOL_SIZE=10
DB_MAX_OVERFLOW=20
DB_POOL_TIMEOUT=30
DB_POOL_RECYCLE=300
AUTO_SEED_DATA=True
POSTGIS_ENABLED=False

# Allowed CORS Origins (JSON array or comma-separated)
CORS_ORIGINS=["http://localhost:5173", "http://127.0.0.1:5173", "http://localhost:3000", "http://127.0.0.1:3000"]

# External Integrations (Placeholders for Future Phases)
GOOGLE_MAPS_API_KEY=
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_PHONE_NUMBER=
LLM_API_KEY=
VECTOR_DATABASE_URL=
